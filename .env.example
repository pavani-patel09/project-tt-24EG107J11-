# ===================================================================
# MediKiosk AI Platform — Production Environment Variables Template
# Copy to your deployment platforms (Railway for backend, Vercel for frontend)
# DO NOT COMMIT REAL PASSWORDS OR SECRETS TO VERSION CONTROL
# ===================================================================

# -------------------------------------------------------------------
# Railway Backend Environment Variables
# -------------------------------------------------------------------
# Port (Railway automatically sets PORT, defaults to 8080 if not set)
PORT=8080

# Aiven Managed MySQL Database Connection
# Format: jdbc:mysql://<AIVEN_HOST>:<AIVEN_PORT>/<AIVEN_DB_NAME>?sslMode=REQUIRED
SPRING_DATASOURCE_URL=jdbc:mysql://<aiven-host>:<aiven-port>/<aiven-database>?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=<aiven-username>
SPRING_DATASOURCE_PASSWORD=<aiven-password>

# JWT Secret (Generate a strong 256-bit / 64-char hex string for production)
JWT_SECRET=<generate_a_secure_random_64_character_hex_key>

# Allowed CORS Origins (Comma-separated URLs of your deployed frontend)
ALLOWED_ORIGINS=https://<your-project>.vercel.app

# Optional AI Integration
GEMINI_API_KEY=

# -------------------------------------------------------------------
# Vercel Frontend Environment Variables
# -------------------------------------------------------------------
# Set this in your Vercel Project Settings -> Environment Variables
# Point to your live Railway backend URL with /api suffix
VITE_API_BASE=https://<your-railway-app>.up.railway.app/api
